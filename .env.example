# Graphic Design System — environment configuration
# Copy to `.env` locally. Never commit real credentials.
# Secrets are read only via process.env (see src/lib/env.ts).

# Optional durable audit JSONL (tokens are redacted before write)
# GDS_AUDIT_LOG_PATH=artifacts/audit.jsonl

# Job artifact root (versioned briefs/concepts/specs/critiques/exports)
# GDS_JOBS_ROOT=artifacts/jobs

# Capability cache TTL (ms)
# GDS_CAPABILITY_CACHE_TTL_MS=900000

# Bounded retries
# GDS_MAX_RETRY_ATTEMPTS=4
# GDS_RETRY_BASE_DELAY_MS=800
# GDS_RETRY_MAX_DELAY_MS=8000

# Export polling (overridable by capability report)
# GDS_EXPORT_MAX_POLLS=20
# GDS_EXPORT_POLL_INTERVAL_MS=1500

# Optional Connect / MCP bridge secrets — leave empty when Cursor hosts Design MCP auth.
# CANVA_MCP_AUTH_TOKEN=
# CANVA_CONNECT_CLIENT_ID=
# CANVA_CONNECT_CLIENT_SECRET=
# CANVA_CONNECT_ACCESS_TOKEN=
# CANVA_CONNECT_REFRESH_TOKEN=
